	local saveDebounce = 0
	local function scheduleSave()
		local now = os.clock()
		if now - saveDebounce < 0.4 then return end
		saveDebounce = now
		pcall(function() cfg._save() end)
	end

	local function makeSlider(name, order, minVal, maxVal, default, callback)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 84)
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = order
		holder.Parent = list

		local topRow = Instance.new("Frame")
