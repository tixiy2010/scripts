-- ============================================================
local plr = game:GetService("Players").LocalPlayer
local repstorage = game:GetService("ReplicatedStorage")

local cfg = getgenv().Evade

local funcs = require(repstorage:WaitForChild("Objects").Game.Character.Client.Movement.MoveFunction.Functions)

local strafeCut, backCut = 0.65, 0.4
local accel, turn = 80, 10
local gain, decay, swingRef = 25, 8, 5
local ease, drag, brake = 70, 18, 200
local scale = 90

-- Порог разворота: dot < 0.5 → угол > ~60°
local TURN_RESET_DOT = 0.5

if not getgenv().Evd then
	getgenv().Evd = true

	local spd, extra = 0, 0
	local lastY = 0
	local lastLocalWish = nil

	local function step(dt, data, mover, state, grounded)
		if not (mover and mover.BaseMover) then return mover, state end

		local look = data:Get("LookCFrame")
		local input = data:Get("MoveDirection") or Vector3.zero

		-- Локальный ввод — для детекта разворота
		local localWish = Vector2.new(input.X, input.Z)
		local moving = localWish.Magnitude > 0.05

		-- ★ Детект резкого разворота по ЛОКАЛЬНОМУ вводу
		-- (поворот камеры при зажатом W не триггерит, т.к. локальный ввод не меняется)
		if moving then
			local newLocal = localWish.Unit
			if lastLocalWish then
				local dot = newLocal:Dot(lastLocalWish)
				if dot < TURN_RESET_DOT then
					spd = 0
					extra = 0
					mover.BaseMover.PlaneVelocity = Vector2.new(0, 0)
					if state and state.Velocity then
						state.Velocity = Vector3.new(0, state.Velocity.Y, 0)
					end
				end
			end
			lastLocalWish = newLocal
		else
			lastLocalWish = nil
		end

		-- ★ МИРОВОЕ направление движения — как в оригинале
		local world = look and look:VectorToWorldSpace(input) or input
		local wish = Vector2.new(world.X, world.Z)
		local moveDir = moving and wish.Unit or Vector2.new(0, 0)

		local face = look and Vector2.new(look.LookVector.X, look.LookVector.Z) or Vector2.new(0, -1)
		if face.Magnitude > 0 then face = face.Unit end

		local align = 1
		if moving and face.Magnitude > 0 then
			align = moveDir:Dot(face)
		end

		local cut
		if align >= 0 then
			cut = strafeCut + (1 - strafeCut) * align
		else
			cut = math.max(backCut, strafeCut + (strafeCut - backCut) * align)
		end

		local y = look and math.atan2(look.LookVector.X, look.LookVector.Z) or lastY
		local dy = (y - lastY + math.pi) % (2 * math.pi) - math.pi
		lastY = y
		local swing = dt > 0 and math.clamp(math.abs(dy) / dt / swingRef, 0, 1) or 0
		extra = math.clamp(extra + ((moving and swing * gain or 0) - decay) * dt, 0, cfg.maxSpeed - cfg.topSpeed)

		local target = moving and (cfg.topSpeed + extra) * cut or 0
		if spd < target then
			spd = math.min(target, spd + accel * dt)
		else
			spd = math.max(target, spd - (moving and ease or (grounded and brake or drag)) * dt)
		end

		local v = moveDir * (spd * scale)

		mover.BaseMover.PlaneVelocity = v
		if state and state.Velocity then
			state.Velocity = Vector3.new(v.X, state.Velocity.Y, v.Y)
		end
		return mover, state
	end

	local run, air = funcs.Run, funcs.Air

	funcs.Run = function(dt, m, data, char, stats)
		local mover, state = run(dt, m, data, char, stats)
		return step(dt, data, mover, state, true)
	end

	funcs.Air = function(dt, m, data, char, stats)
		local mover, state = air(dt, m, data, char, stats)
		return step(dt, data, mover, state, false)
	end
end

