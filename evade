		b2.MouseButton1Click:Connect(function() setByValue(getCurrentValue() - 1) end)
		b3.MouseButton1Click:Connect(function() setByValue(getCurrentValue() + 1) end)
		b4.MouseButton1Click:Connect(function() setByValue(getCurrentValue() + 10) end)
		b5.MouseButton1Click:Connect(function() setByValue(default) end)

		return { setValue = setByValue, getValue = getCurrentValue }
