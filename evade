local BotFolder = Workspace:WaitForChild("Players", 10)
local EffectsFolder = Workspace:WaitForChild("Effects", 10)

local TicketsFolder = Workspace:WaitForChild("Tickets", 10)
if not TicketsFolder and EffectsFolder then
	TicketsFolder = EffectsFolder:WaitForChild("Tickets", 10)
end

if not BotFolder then return end
if not EffectsFolder then return end
