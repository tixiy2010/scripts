local CONFIG_FOLDER = "tixiydev"
local CONFIG_FILE = "evade.txt"
local CONFIG_PATH = CONFIG_FOLDER .. "/" .. CONFIG_FILE

local function ensureFolder()
	if isfolder and makefolder and not isfolder(CONFIG_FOLDER) then
		pcall(makefolder, CONFIG_FOLDER)
	end
end

local function loadConfig()
	ensureFolder()
	local defaults = { topSpeed = 60, maxSpeed = 90 }
	if not (isfile and readfile) then return defaults end
	if not isfile(CONFIG_PATH) then return defaults end
	local ok, content = pcall(readfile, CONFIG_PATH)
	if not ok or not content then return defaults end
	local result = { topSpeed = defaults.topSpeed, maxSpeed = defaults.maxSpeed }
	for key, value in string.gmatch(content, "([%w_]+)%s*=%s*([%d%.%-]+)") do
		local num = tonumber(value)
		if num then result[key] = num end
	end
	return result
end

local function saveConfig(data)
	ensureFolder()
	if not writefile then return end
	local lines = {
		"-- Evade config (tixiydev)",
		"-- auto-generated, можно редактировать вручную",
		"topSpeed=" .. tostring(math.floor((data.topSpeed or 60) + 0.5)),
		"maxSpeed=" .. tostring(math.floor((data.maxSpeed or 90) + 0.5)),
	}
	pcall(writefile, CONFIG_PATH, table.concat(lines, "\n"))
end

local _savedCfg = loadConfig()
getgenv().Evade = getgenv().Evade or {}
getgenv().Evade.topSpeed = _savedCfg.topSpeed
getgenv().Evade.maxSpeed = _savedCfg.maxSpeed
getgenv().Evade._save = function()
	saveConfig(getgenv().Evade)
end

