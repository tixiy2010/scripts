	end)

	local maxSlider = makeSlider("Max Speed", 2, 10, 300, cfg.maxSpeed, function(v)
		if v < cfg.topSpeed then
			cfg.maxSpeed = cfg.topSpeed
			if maxSlider then maxSlider.setValue(cfg.topSpeed) end
		else
			cfg.maxSpeed = v
		end
		scheduleSave()
	end)

	close.MouseButton1Click:Connect(function()
		pcall(function() cfg._save() end)
		gui.Enabled = false
	end)

